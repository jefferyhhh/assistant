# ============================================================
# AI Assistant 环境变量配置
# 复制此文件为 .env.local 并填入你的配置
# ============================================================

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=assistant

# ---- OpenAI (或其他兼容 API) ----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://your-proxy.com/v1   # 可选：代理或兼容 API 地址

# ---- Agent ----
# AGENT_SYSTEM_PROMPT=你是一个智能助手，可以使用工具来帮助用户解决问题。请用中文回复。

# ---- MCP (预留) ----
# MCP_CONFIG_PATH=./mcp-servers.json
